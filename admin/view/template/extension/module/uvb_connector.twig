                        <div class="pull-right">
                            <a href="{{ uvb_link_knowledge_base }}" style="margin-left: .5rem">{{ text_knowledge_base }}</a>
                            <a href="{{ uvb_link_register }}" style="margin-left: .5rem">{{ text_register }}</a>
                            <a href="{{ uvb_link_login }}" style="margin-left: .5rem">{{ text_login }}</a>
                            <a href="{{ uvb_link_support }}" style="margin-left: .5rem" target="_top">{{ text_support }}</a>
