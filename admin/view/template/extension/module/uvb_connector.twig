        </div>
        {# UVB Links END #}
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
            </div>
            <div class="panel-body">
                <ul class="nav nav-tabs">
                    <li class="active"><a href="#tab-general" data-toggle="tab">{{ tab_settings }}</a></li>
                    <li><a href="#tab-log" data-toggle="tab">{{ tab_log }}</a></li>
                </ul>
                <div class="tab-content">
                    <div class="tab-pane active" id="tab-general">

                        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-uvb-connector" class="form-horizontal">
                            <div class="form-group">
                                <label class="col-sm-2 control-label" for="input-public-key">{{ entry_public_key }}</label>
                                <div class="col-sm-10">
                                    <input type="text" name="module_uvb_connector_public_key" value="{{ module_uvb_connector_public_key }}" placeholder="{{ entry_public_key }}"  class="form-control" id="input-public-key" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-2 control-label" for="input-private-key">{{ entry_private_key }}</label>
                                <div class="col-sm-10">
                                    <input type="text" name="module_uvb_connector_private_key" value="{{ module_uvb_connector_private_key }}" placeholder="{{ entry_private_key }}" class="form-control" id="input-private-key" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-2 control-label" >{{ entry_sandbox }}</label>
                                <div class="col-sm-10">
                                    {% if module_uvb_connector_sandbox %}
                                        <label class="radio-inline"><input type="radio" name="module_uvb_connector_sandbox" value="1" checked="checked"> {{ text_yes }}</label>
                                        <label class="radio-inline"><input type="radio" name="module_uvb_connector_sandbox" value="0"> {{ text_no }}</label>
                                    {% else %}
                                        <label class="radio-inline"><input type="radio" name="module_uvb_connector_sandbox" value="1"> {{ text_yes }}</label>
                                        <label class="radio-inline"><input type="radio" name="module_uvb_connector_sandbox" value="0" checked="checked"> {{ text_no }}</label>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-2 control-label" for="input-reputation-threshold"><span data-toggle="tooltip" title="" data-original-title="{{ help_reputation_threshold }}">{{ entry_reputation_threshold }}</span></label>
                                <div class="col-sm-10">
                                    <input type="number" max="1" step="0.0001" style="width:100px;" name="module_uvb_connector_reputation_threshold" value="{{ module_uvb_connector_reputation_threshold }}"  id="input-reputation-threshold" class="form-control" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-2 control-label" for="input-status-good">{{ entry_status_good }}</label>
                                <div class="col-sm-10">
                                    <select name="module_uvb_connector_status_good" id="input-status-good" class="form-control">
                                        {% for order_status in order_statuses %}
                                            {% if module_uvb_connector_status_good == order_status.order_status_id %}
                                                <option value="{{ order_status.order_status_id }}" selected="selected">{{ order_status.name }}</option>
                                            {% else %}
                                                <option value="{{ order_status.order_status_id }}">{{ order_status.name }}</option>
                                            {% endif %}
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-2 control-label" for="input-status-bad">{{ entry_status_bad }}</label>
                                <div class="col-sm-10">
                                    <select name="module_uvb_connector_status_bad" id="input-status-bad" class="form-control">
                                        {% for order_status in order_statuses %}
                                            {% if module_uvb_connector_status_bad == order_status.order_status_id %}
                                                <option value="{{ order_status.order_status_id }}" selected="selected">{{ order_status.name }}</option>
                                            {% else %}
                                                <option value="{{ order_status.order_status_id }}">{{ order_status.name }}</option>
                                            {% endif %}
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-2 control-label" for="input-status">{{ entry_stores }}</label>
                                <div class="col-sm-10">
                                    <div class="well">
                                        {% for store in stores %}
                                            <div>
                                                {% if store.store_id in module_uvb_connector_stores %}
                                                    <input type="checkbox" name="module_uvb_connector_stores[]" value="{{ store.store_id }}" id="input-store{{ store.store_id }}" checked> <label for="input-store{{ store.store_id }}">{{ store.name }}</label>
                                                {% else %}
                                                    <input type="checkbox" name="module_uvb_connector_stores[]" value="{{ store.store_id }}" id="input-store{{ store.store_id }}"> <label for="input-store{{ store.store_id }}">{{ store.name }}</label>
                                                {% endif %}
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-2 control-label" for="input-status">{{ entry_disabled_payment_methods }}</label>
                                <div class="col-sm-10">
                                    <div class="well">
                                        {% for payment_method in payment_methods %}
                                            <div>
                                                {% if payment_method.code in module_uvb_connector_disabled_payment_methods %}
                                                    <input type="checkbox" name="module_uvb_connector_disabled_payment_methods[]" value="{{ payment_method.code }}" id="input-{{ payment_method.code }}" checked> <label for="input-{{ payment_method.code }}">{{ payment_method.name }}</label>
                                                {% else %}
                                                    <input type="checkbox" name="module_uvb_connector_disabled_payment_methods[]" value="{{ payment_method.code }}" id="input-{{ payment_method.code }}"> <label for="input-{{ payment_method.code }}">{{ payment_method.name }}</label>
                                                {% endif %}
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-2 control-label" for="input-log">{{ entry_log }}</label>
                                <div class="col-sm-10">
                                    {% if module_uvb_connector_log %}
                                        <label class="radio-inline"><input type="radio" name="module_uvb_connector_log" value="1" checked="checked"> {{ text_yes }}</label>
                                        <label class="radio-inline"><input type="radio" name="module_uvb_connector_log" value="0"> {{ text_no }}</label>
                                    {% else %}
                                        <label class="radio-inline"><input type="radio" name="module_uvb_connector_log" value="1"> {{ text_yes }}</label>
                                        <label class="radio-inline"><input type="radio" name="module_uvb_connector_log" value="0" checked="checked"> {{ text_no }}</label>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
                                <div class="col-sm-10">
                                    <select name="module_uvb_connector_status" id="input-status" class="form-control">
                                        {% if module_uvb_connector_status %}
                                            <option value="1" selected="selected">{{ text_enabled }}</option>
                                            <option value="0">{{ text_disabled }}</option>
                                        {% else %}
                                            <option value="1">{{ text_enabled }}</option>
                                            <option value="0" selected="selected">{{ text_disabled }}</option>
                                        {% endif %}
                                    </select>
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="tab-pane" id="tab-log">
                        <div class="container-fluid">
                            {% if error_log_warning %}
                                <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_log_warning }}
                                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                                </div>
                            {% endif %}
                            <div class="row">
                                <div class="col-sm-12">
                                    <div class="text-right" style="margin-bottom:10px">
                                        <a href="{{ download }}" data-toggle="tooltip" title="{{ button_download }}" class="btn btn-primary"><i class="fa fa-download"></i></a>
                                        <a onclick="confirm('{{ text_confirm }}') ? location.href='{{ clear }}' : false;" data-toggle="tooltip" title="{{ button_clear }}" class="btn btn-danger"><i class="fa fa-eraser"></i></a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="container-fluid">
                            <textarea wrap="off" rows="15" readonly class="form-control">{{ log }}</textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{{ footer }}